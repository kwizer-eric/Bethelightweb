# Production site URL (canonical links, Open Graph, sitemap). No trailing slash.
VITE_SITE_URL=https://kubwabofoundation.org

# Optional: paste the content value from Google Search Console → Ownership verification
VITE_GOOGLE_SITE_VERIFICATION=

# Public browser keys. Vite bakes these in at build time, so change them and redeploy.
# Use the publishable key (sb_publishable_...), not the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional aliases if the host was set up with Next.js names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
