# Public browser keys. Vite bakes these in at build time, so change them and redeploy.
# Use the publishable key (sb_publishable_...), not the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional aliases if the host was set up with Next.js names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
